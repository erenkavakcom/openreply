# Postgres veritabanı adresi. Vercel'de Storage sekmesinden Neon (ücretsiz) eklersen kendiliğinden gelir.
DATABASE_URL=

# Yönetim paneline giriş şifren. En az 10 karakter; kimseyle paylaşma.
ADMIN_PASSWORD=

# İsteğe bağlı: sıradaki DM'leri gönderen zamanlayıcı için gizli kelime (Vercel Cron bunu kendisi gönderir).
CRON_SECRET=

# İsteğe bağlı: sorun olunca Telegram'dan haber almak için (bot token ve sohbet kimliği).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
